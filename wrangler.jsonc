{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-brieff",
  // Astro 7 + @astrojs/cloudflare: custom entry exports DO/Workflow classes.
  "main": "src/lib/agents/editorial-agent.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": [
        "arturo@strtgy.ai",
        "mar@strtgy.ai"
      ],
      "allowed_sender_addresses": ["prensa@strtgy.ai"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "5c710f3007c748b9bf7b2c9f8547bf0e",
      "preview_id": "13da37c085b8488e9d6fca926dcde59d"
    }
  ],
  // Non-production / local placeholders. Remote D1, R2, Vectorize, Queues,
  // Workflows, DO migrations, and AI Gateway provisioning require Approval Gates.
  "d1_databases": [
    {
      "binding": "EDITORIAL_DB",
      "database_name": "el-brieff-editorial",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "preview_database_id": "el-brieff-editorial-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EDITORIAL_DOCUMENTS",
      "bucket_name": "el-brieff-editorial-documents-local",
      "preview_bucket_name": "el-brieff-editorial-documents-preview"
    }
  ],
  "vectorize": [
    {
      "binding": "KNOWLEDGE_INDEX",
      "index_name": "el-brieff-knowledge-local"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_GATEWAY_ID": "default",
    "ACCESS_ALLOWED_EMAILS": "arturo@strtgy.ai",
    "EDITORIAL_DEV_ACTOR_EMAIL": "arturo@strtgy.ai"
  },
  "queues": {
    "producers": [
      {
        "binding": "EDITORIAL_QUEUE",
        "queue": "el-brieff-editorial-delivery-local"
      }
    ]
  },
  "workflows": [
    {
      "binding": "EDITORIAL_WORKFLOW",
      "name": "el-brieff-editorial-publish-local",
      "class_name": "EditorialPublishWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EDITORIAL_AGENT",
        "class_name": "EditorialAgent"
      }
    ]
  },
  "exports": {
    "EditorialAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
