{
  "name": "el-brieff",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cf:deploy": "rm -f .wrangler/deploy/config.json && wrangler deploy --config wrangler.jsonc",
    "cf:preview": "rm -f .wrangler/deploy/config.json && wrangler versions upload --config wrangler.jsonc",
    "deploy": "npm run build && npm run cf:deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "astro": "^7.1.6",
    "wrangler": "^4.118.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
