---
import { site } from '../config/site';

type JsonLdProps = {
  graph?: Record<string, unknown> | Record<string, unknown>[];
};

const { graph } = Astro.props as JsonLdProps;

const personId = `${site.siteUrl}/#person`;
const orgId = `${site.siteUrl}/#organization`;
const imageUrl = new URL(site.ogImage, site.siteUrl).href;

const defaultGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'PodcastSeries',
      name: site.name,
      description: site.pitch,
      url: site.siteUrl,
      inLanguage: 'es-MX' as const,
      image: imageUrl,
      sameAs: [site.spotify.showUrl, site.social.instagram],
      author: { '@id': personId },
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: site.host.name,
      alternateName: site.host.alternateName,
      sameAs: [site.social.instagram],
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: site.producer.name,
    },
  ],
};

const payload = graph ?? defaultGraph;
const jsonLd = JSON.stringify(payload);
---

<script type="application/ld+json" set:html={jsonLd} />
