---
import { Image } from 'astro:assets';
import arturoImage from '../assets/arturo-cover.png';
import { site } from '../config/site';

const HERO_HOOK = 'Entiende lo importante de México y el mundo en 15 minutos.';
const HERO_CREDIT = 'Con Arturo Salazar (@elchearturo) · Lunes a viernes';
const CTA_PRIMARY = { label: 'Escuchar ahora', href: '#escuchar' };
const CTA_SECONDARY = {
  label: 'Abrir en Spotify',
  href: site.spotify.showUrl,
};
---

<section class="hero" aria-labelledby="hero-brand">
  <div class="hero__inner">
    <div class="hero__media">
      <Image
        class="hero__cover"
        src={arturoImage}
        alt="Arturo Salazar, conductor de El Brieff"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        sizes="(min-width: 900px) 50vw, 100vw"
      />
    </div>
    <div class="hero__copy">
      <h1 class="hero__wordmark" id="hero-brand" aria-label="El Brieff">
        <span aria-hidden="true">EL</span>
        <span aria-hidden="true">BRI</span>
        <span aria-hidden="true">EFF</span>
      </h1>
      <div class="hero__lede">
        <p class="hero__hook">{HERO_HOOK}</p>
        <p class="hero__credit">{HERO_CREDIT}</p>
      </div>
      <div class="hero__ctas">
        <a
          class="hero__cta hero__cta--primary"
          href={CTA_PRIMARY.href}
          data-analytics-event="listen_cta"
          data-analytics-cta-id="escuchar_ahora"
          data-analytics-cta-location="hero"
        >
          {CTA_PRIMARY.label}
        </a>
        <a
          class="hero__cta hero__cta--secondary"
          href={CTA_SECONDARY.href}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="listen_cta"
          data-analytics-cta-id="abrir_spotify"
          data-analytics-cta-location="hero"
        >
          {CTA_SECONDARY.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(ellipse 55% 70% at 28% 50%, var(--surface-elevated) 0%, transparent 65%),
      var(--primary);
    overflow: hidden;
  }

  /* ---- INNER CONTAINER ---- */

  .hero__inner {
    display: flex;
    flex-direction: column-reverse; /* mobile: copy above media (DOM: media first = paints behind) */
    gap: var(--space-xl);
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: calc(4.5rem + var(--space-lg)) var(--space-md) var(--space-xl);
  }

  @media (min-width: 900px) {
    .hero__inner {
      flex-direction: row;
      align-items: center;
      padding: calc(5rem + var(--space-lg)) var(--space-xl) var(--space-xl);
    }
  }

  /* ---- COPY COLUMN ---- */

  .hero__copy {
    position: relative;
    z-index: 1; /* ensures copy stacks above absolutely-positioned media on desktop */
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    animation: hero-fade-up 0.9s var(--ease-settle) both;
  }

  @media (min-width: 900px) {
    .hero__copy {
      max-width: 34rem;
    }
  }

  .hero__wordmark {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 10vw, 5.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    animation: hero-settle 1.1s var(--ease-settle) both;
  }

  .hero__lede {
    margin: 0;
    max-width: 32rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    animation: hero-fade-up 0.9s var(--ease-fade) 0.12s both;
  }

  .hero__hook {
    margin: 0;
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
  }

  .hero__credit {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    animation: hero-fade-up 0.9s var(--ease-fade) 0.22s both;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1.25rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color 0.2s var(--ease-fade),
      color 0.2s var(--ease-fade),
      border-color 0.2s var(--ease-fade);
  }

  .hero__cta:hover {
    text-decoration: none;
  }

  .hero__cta--primary {
    background: var(--tertiary);
    color: var(--ink-on-light);
    border: 1px solid var(--tertiary);
  }

  .hero__cta--primary:hover {
    background: transparent;
    color: var(--ink);
    border-color: var(--tertiary);
  }

  .hero__cta--secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--border);
  }

  .hero__cta--secondary:hover {
    border-color: var(--ink);
  }

  .hero__cta--secondary:focus-visible {
    outline-color: var(--tertiary);
  }

  /* ---- MEDIA PANEL ---- */

  /* Mobile: contained card below copy */
  .hero__media {
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
    animation: hero-settle 1.2s var(--ease-settle) 0.08s both;
  }

  /* Desktop: escape flex flow; bleed to viewport right edge */
  @media (min-width: 900px) {
    .hero__media {
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 50vw;
      max-width: none;
      margin-inline: 0;
      animation: hero-panel-in 1.6s var(--ease-settle) 0.05s both;
    }

    /* Gradient fade: blends photo into the dark background at the left edge */
    .hero__media::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 40%;
      background: linear-gradient(to right, var(--primary) 0%, transparent 100%);
      z-index: 1;
      pointer-events: none;
    }
  }

  /* Mobile: bordered card — full photo visible */
  .hero__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-elevated);
  }

  /* Desktop: full-height fill, no box */
  @media (min-width: 900px) {
    .hero__cover {
      border: none;
      border-radius: 0;
      background: transparent;
      aspect-ratio: auto;
      height: 100%;
      object-fit: cover;
      object-position: center 15%;
    }
  }

  /* ---- KEYFRAMES ---- */

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-settle {
    from {
      opacity: 0;
      transform: scale(0.98) translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Cinematic entrance for the full-bleed panel */
  @keyframes hero-panel-in {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy,
    .hero__wordmark,
    .hero__lede,
    .hero__ctas,
    .hero__media {
      animation: none;
    }
  }
</style>
