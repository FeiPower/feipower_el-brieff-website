---
import { site } from '../config/site';
import { HERO_IMAGE } from '../lib/hero-image';

const HERO_LEDE = site.pitch;

/* One listen path out of the hero. Spotify itself is reachable from the embed
   below and from the platform list, so a second hero CTA only splits intent. */
const LISTEN_CTA = { label: 'Escuchar ahora', href: '#escuchar' };
---

<section class="hero" aria-labelledby="hero-brand">
  <div class="hero__inner">
    <div class="hero__media">
      <picture>
        <source
          type="image/avif"
          srcset={HERO_IMAGE.avifSrcSet}
          sizes={HERO_IMAGE.sizes}
        />
        <source
          type="image/webp"
          srcset={HERO_IMAGE.webpSrcSet}
          sizes={HERO_IMAGE.sizes}
        />
        <img
          class="hero__cover"
          src={HERO_IMAGE.src}
          alt={HERO_IMAGE.alt}
          width={HERO_IMAGE.width}
          height={HERO_IMAGE.height}
          decoding="async"
          fetchpriority="high"
          sizes={HERO_IMAGE.sizes}
        />
      </picture>
    </div>
    <div class="hero__copy">
      <div class="hero__identity">
        <h1 class="hero__wordmark" id="hero-brand">
          <img
            class="hero__logo"
            src={site.logo}
            alt={site.name}
            width="938"
            height="999"
            decoding="async"
            fetchpriority="high"
          />
        </h1>
        <p class="hero__lede">{HERO_LEDE}</p>
      </div>
      <a
        class="hero__cta"
        href={LISTEN_CTA.href}
        data-analytics-event="listen_cta"
        data-analytics-cta-id="escuchar_ahora"
        data-analytics-cta-location="hero"
      >
        {LISTEN_CTA.label}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    /* Mobile: the inner grid must own the full height so the media row can
       take the space left over by the copy. Desktop centers instead. */
    align-items: stretch;
    /* One solid plane — no radial lift, no grain, no copy/media seam */
    background: var(--primary);
    overflow: clip;
  }

  @media (min-width: 900px) {
    .hero {
      align-items: center;
      overflow: hidden;
    }
  }

  /* ---- INNER CONTAINER ---- */

  /*
   * Mobile is cover-first: copy occupies the top row, the portrait fills the
   * remaining viewport height and bleeds to the section edges (DOM order keeps
   * media first so it paints behind the copy on desktop).
   */
  .hero__inner {
    display: grid;
    /* minmax(0, 1fr): the media row takes leftover height instead of the
       image's intrinsic square, which would inflate the whole section. */
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--space-lg);
    width: 100%;
    min-height: 100svh;
    max-width: 72rem;
    margin: 0 auto;
    padding: calc(var(--header-h) + var(--space-lg)) var(--space-lg) 0;
  }

  /* Short phones: buy the portrait more of the first viewport */
  @media (max-width: 899px) and (max-height: 740px) {
    .hero__inner {
      gap: var(--space-md);
      padding-top: calc(var(--header-h) + var(--space-sm));
    }

    .hero__copy {
      gap: var(--space-lg);
    }

    .hero__identity {
      gap: var(--space-sm);
    }
  }

  /* Landscape phones: let the page scroll instead of crushing the composition */
  @media (max-width: 899px) and (max-height: 560px) {
    .hero {
      min-height: auto;
    }

    .hero__inner {
      min-height: 0;
      padding-bottom: 0;
    }
  }

  @media (min-width: 900px) {
    .hero__inner {
      display: flex;
      flex-direction: row;
      align-items: center;
      padding: calc(var(--header-h) + var(--space-md)) var(--space-xl)
        var(--space-xl);
    }
  }

  /* ---- COPY COLUMN ---- */

  .hero__copy {
    grid-row: 1;
    position: relative;
    z-index: var(
      --z-raised
    ); /* stacks above the absolutely-positioned media on desktop */
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Generous separation between identity block and the single listen action */
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .hero__copy {
      flex: 0 1 34rem;
      max-width: 34rem;
    }
  }

  /* Tight cluster: wordmark owns the brand; lede sits under it as one unit */
  .hero__identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    max-width: 100%;
  }

  .hero__wordmark {
    margin: 0;
    max-width: 100%;
  }

  /* Canonical SVG mark — not selectable HTML lettering */
  .hero__logo {
    display: block;
    width: clamp(8.5rem, 26vw, 13.5rem);
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .hero__lede {
    margin: 0;
    max-width: 28ch;
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    line-height: 1.45;
    color: var(--muted);
    overflow-wrap: break-word;
    text-wrap: pretty;
  }

  /* Intrinsic width to match about CTA; height still meets the 44px touch floor */
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    background: var(--tertiary);
    color: var(--ink-on-light);
    border: 1px solid var(--tertiary);
    border-radius: var(--radius-sm);
    transition:
      background-color 0.2s var(--ease-fade),
      color 0.2s var(--ease-fade),
      border-color 0.2s var(--ease-fade);
  }

  @media (pointer: coarse) {
    .hero__cta {
      min-height: 3rem;
    }
  }

  /* Touch devices keep :active feedback; hover styles would stick after a tap */
  @media (hover: hover) {
    .hero__cta:hover {
      background: transparent;
      color: var(--ink);
      border-color: var(--tertiary);
      text-decoration: none;
    }
  }

  .hero__cta:active {
    background: var(--surface-elevated);
    color: var(--ink);
    border-color: var(--tertiary);
  }

  /* ---- MEDIA PANEL ---- */

  /*
   * Transparent cut-out over the hero’s solid --primary. No panel fill and no
   * side soft-edge — those read as a second background / vertical seam.
   */
  .hero__media {
    grid-row: 2;
    position: relative;
    /* Floor for short screens, where leftover height alone would collapse it */
    min-height: 38svh;
    margin-inline: calc(-1 * var(--space-lg));
    overflow: hidden;
    background: transparent;
    container-type: size;
  }

  @media (max-width: 899px) and (max-height: 740px) {
    .hero__media {
      min-height: 26svh;
    }
  }

  @media (max-width: 899px) and (max-height: 560px) {
    .hero__media {
      min-height: 11rem;
    }
  }

  /* Out of flow so the square source never dictates the panel's height */
  .hero__media picture {
    position: absolute;
    inset: 0;
    display: block;
    background: transparent;
  }

  /*
   * Soft dissolve under the cut-out. Lives on the media panel (not the img)
   * so transform/scale on the portrait cannot push the fade off-screen.
   */
  .hero__media::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 42%;
    background: linear-gradient(
      to top,
      var(--primary) 0%,
      color-mix(in srgb, var(--primary) 75%, transparent) 35%,
      transparent 100%
    );
    z-index: var(--z-raised);
    pointer-events: none;
  }

  /* Desktop: escape flex flow; bleed to viewport inline-end edge */
  @media (min-width: 900px) {
    .hero__inner {
      min-height: 0;
    }

    .hero__media {
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0;
      width: 58vw;
      min-height: 0;
      margin-inline: 0;
    }

    .hero__media::after {
      height: 38%;
    }
  }

  /*
   * Alpha cut-out (npm run optimize:hero). No plated rectangle — Arturo sits
   * directly on the solid green hero plane.
   */
  .hero__cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
    border: none;
    border-radius: 0;
    background: transparent;
    /* The source is a square cut-out, so a cover fit leaves the subject small.
       Crop tiers key off the panel itself, not the viewport. */
    transform: scale(1.6);
    transform-origin: 50% 26%;
  }

  /* Wide panel: the cover fit already fills, so pull the zoom back */
  @container (min-width: 520px) {
    .hero__cover {
      transform: scale(1.2);
      transform-origin: 50% 22%;
    }
  }

  /* Short panel: shift down the crop or it shows only the top of the head */
  @container (max-height: 300px) {
    .hero__cover {
      transform: scale(1.45);
      transform-origin: 50% 32%;
    }
  }

  @media (min-width: 900px) {
    .hero__cover {
      object-position: center 18%;
      transform: scale(1.18);
      transform-origin: 54% 28%;
    }
  }

  /* ---- KEYFRAMES ---- */

  @keyframes hero-fade-up {
    from {
      transform: translateY(1rem);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(0.98) translateY(0.5rem);
    }
    to {
      transform: scale(1) translateY(0);
    }
  }

  /* Cinematic entrance for the full-bleed panel */
  @keyframes hero-panel-in {
    from {
      transform: scale(1.04);
    }
    to {
      transform: scale(1);
    }
  }

  /* Motion only when preferred — opacity never gated on animation.
     Each line animates once; a wrapper animation would compound the translate. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__wordmark {
      animation: hero-settle 1.1s var(--ease-settle) both;
    }

    .hero__lede {
      animation: hero-fade-up 0.9s var(--ease-fade) 0.12s both;
    }

    .hero__cta {
      animation: hero-fade-up 0.9s var(--ease-fade) 0.22s both;
    }

    /*
     * Scale entrance. Backwards fill only — no lingering transform on the
     * transparent cut-out.
     */
    .hero__media {
      animation: hero-panel-in 1.4s var(--ease-settle) 0.08s backwards;
    }

    @media (min-width: 900px) {
      .hero__media {
        animation-duration: 1.6s;
        animation-delay: 0.05s;
      }
    }
  }
</style>
