---
import { site } from '../config/site';

const HERO_LEDE = site.pitch;
const CTA_PRIMARY = { label: 'Escuchar ahora', href: '#escuchar' };
const CTA_SECONDARY = {
  label: 'Abrir en Spotify',
  href: site.spotify.showUrl,
};
---

<section class="hero" aria-labelledby="hero-brand">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__wordmark" id="hero-brand">
        <span>EL</span>
        <span>BRI</span>
        <span>EFF</span>
      </h1>
      <p class="hero__lede">{HERO_LEDE}</p>
      <div class="hero__ctas">
        <a class="hero__cta hero__cta--primary" href={CTA_PRIMARY.href}>
          {CTA_PRIMARY.label}
        </a>
        <a
          class="hero__cta hero__cta--secondary"
          href={CTA_SECONDARY.href}
          rel="noopener noreferrer"
        >
          {CTA_SECONDARY.label}
        </a>
      </div>
    </div>
    <div class="hero__media">
      <img
        class="hero__cover"
        src={site.ogImage}
        alt="Portada de El Brieff: wordmark EL BRI EFF y Arturo Salazar"
        width="502"
        height="499"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(ellipse 80% 60% at 70% 40%, #1a2420 0%, transparent 55%),
      var(--primary);
    overflow: hidden;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: calc(4.5rem + var(--space-lg)) var(--space-md) var(--space-xl);
  }

  @media (min-width: 900px) {
    .hero__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-xl);
      padding: calc(5rem + var(--space-lg)) var(--space-xl) var(--space-xl);
    }
  }

  .hero__copy {
    flex: 1 1 48%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    animation: hero-fade-up 0.9s var(--ease-settle) both;
  }

  .hero__wordmark {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 10vw, 4.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    animation: hero-settle 1.1s var(--ease-settle) both;
  }

  .hero__lede {
    margin: 0;
    max-width: 32rem;
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    line-height: 1.55;
    color: var(--muted);
    animation: hero-fade-up 0.9s var(--ease-fade) 0.12s both;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    animation: hero-fade-up 0.9s var(--ease-fade) 0.22s both;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1.25rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color 0.2s var(--ease-fade),
      color 0.2s var(--ease-fade),
      border-color 0.2s var(--ease-fade);
  }

  .hero__cta:hover {
    text-decoration: none;
  }

  .hero__cta--primary {
    background: var(--tertiary);
    color: var(--ink-on-light);
    border: 1px solid var(--tertiary);
  }

  .hero__cta--primary:hover {
    background: transparent;
    color: var(--ink);
    border-color: var(--tertiary);
  }

  .hero__cta--secondary {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--border);
  }

  .hero__cta--secondary:hover {
    border-color: var(--ink);
  }

  .hero__media {
    flex: 1 1 48%;
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
    animation: hero-settle 1.2s var(--ease-settle) 0.08s both;
  }

  @media (min-width: 900px) {
    .hero__media {
      margin-inline: auto 0;
      max-width: min(28rem, 46%);
    }
  }

  .hero__cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-elevated);
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-settle {
    from {
      opacity: 0;
      transform: scale(0.98) translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy,
    .hero__wordmark,
    .hero__lede,
    .hero__ctas,
    .hero__media {
      animation: none;
    }
  }
</style>
