---
import { site } from '../config/site';
import { COVER_IMAGE } from '../lib/cover-image';

/* Glossary (listen zone):
 * Escuchar = start or continue listening (in-page or on platform).
 * Abrir = leave this page for Spotify.
 * Ir a Escuchar = scroll/navigate to this zone (not play yet).
 * Failure copy only on timeout; keep SR + visible helper in sync. */
const LISTEN_HEADING = 'Escuchar en Spotify';
const LOAD_EMBED_LABEL = 'Escuchar ahora';
const LOADING_EMBED_LABEL = 'Preparando El Brieff…';
const EMBED_LOADED_STATUS = 'Listo para escuchar.';
const EMBED_READY_CONFIRM = 'Listo para escuchar';
/* Visible helper + live region share one string; link carries the Abrir verb. */
const FALLBACK_HELPER_TIMEOUT =
  'El reproductor no cargó. Ábrelo en Spotify.';
const EMBED_TIMEOUT_STATUS = FALLBACK_HELPER_TIMEOUT;
const FALLBACK_LINK_LABEL = 'Abrir en Spotify';
const EMBED_LOAD_TIMEOUT_MS = 12000;
const EMBED_READY_CONFIRM_MS = 2400;
const facadeHeight = site.spotify.embedFacadeHeight;
const playerHeight = site.spotify.embedPlayerHeight;
const embedSrc = `https://open.spotify.com/embed/show/${site.spotify.showId}?utm_source=generator&theme=${site.spotify.embedTheme}`;
const iframeTitle = 'El Brieff en Spotify';
---

<section class="spotify-embed" id="escuchar" aria-labelledby="escuchar-heading">
  <div class="spotify-embed__inner">
    <h2 class="spotify-embed__heading" id="escuchar-heading">{LISTEN_HEADING}</h2>
    <div class="spotify-embed__stage">
      <div
        class="spotify-embed__player"
        data-spotify-player
        style={`--spotify-embed-h: ${facadeHeight}px`}
      >
        <div class="spotify-embed__facade" data-spotify-facade>
          <picture>
            <source
              type="image/avif"
              srcset={COVER_IMAGE.avifSrcSet}
              sizes={COVER_IMAGE.sizes}
            />
            <source
              type="image/webp"
              srcset={COVER_IMAGE.webpSrcSet}
              sizes={COVER_IMAGE.sizes}
            />
            <img
              class="spotify-embed__facade-cover"
              src={COVER_IMAGE.src}
              alt={COVER_IMAGE.alt}
              width={COVER_IMAGE.width}
              height={COVER_IMAGE.height}
              sizes={COVER_IMAGE.sizes}
              decoding="async"
              loading="lazy"
            />
          </picture>
          <div class="spotify-embed__facade-action">
            <div class="spotify-embed__facade-scrim" aria-hidden="true"></div>
            <a
              class="spotify-embed__facade-btn"
              href={site.spotify.showUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-spotify-load
              data-analytics-event="listen_cta"
              data-analytics-cta-id="cargar_spotify_embed"
              data-analytics-cta-location="listen_zone"
            >
              <span data-spotify-load-label>{LOAD_EMBED_LABEL}</span>
              <span class="visually-hidden" data-spotify-newtab>
                {' '}(se abre en una pestaña nueva)
              </span>
            </a>
          </div>
        </div>
        <p
          class="visually-hidden"
          data-spotify-status
          aria-live="polite"
        ></p>
      </div>
      {/* Sighted success beat (out of flow — no CLS); SR uses the live region. */}
      <p class="spotify-embed__ready" data-spotify-ready hidden aria-hidden="true"></p>
    </div>
    {/* Abrir only on timeout recovery (JS). Hidden for progressive enhancement too —
        facade CTA already deep-links to Spotify without JS. */}
    <div class="spotify-embed__fallback" data-spotify-fallback hidden>
      <p
        class="spotify-embed__fallback-helper"
        id="spotify-fallback-helper"
        data-spotify-fallback-helper
        hidden
      ></p>
      <a
        class="spotify-embed__fallback-link"
        id="spotify-fallback-link"
        href={site.spotify.showUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="listen_cta"
        data-analytics-cta-id="abrir_spotify_fallback"
        data-analytics-cta-location="listen_zone"
      >
        {FALLBACK_LINK_LABEL}
        <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
      </a>
    </div>
  </div>
</section>

<script
  define:vars={{
    embedSrc,
    playerHeight,
    iframeTitle,
    EMBED_LOADED_STATUS,
    EMBED_READY_CONFIRM,
    EMBED_TIMEOUT_STATUS,
    FALLBACK_HELPER_TIMEOUT,
    LOADING_EMBED_LABEL,
    EMBED_LOAD_TIMEOUT_MS,
    EMBED_READY_CONFIRM_MS,
  }}
>
  function prefersMotion() {
    return (
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: no-preference)').matches
    );
  }

  function getSection(root) {
    const section = root.closest('.spotify-embed');
    return section instanceof HTMLElement ? section : null;
  }

  function getFallbackRegion(root) {
    const section = getSection(root);
    if (!section) return null;
    const region = section.querySelector('[data-spotify-fallback]');
    return region instanceof HTMLElement ? region : null;
  }

  function hideFallbackRecovery(root) {
    const region = getFallbackRegion(root);
    if (!region) return;
    region.hidden = true;
    region.removeAttribute('data-recovery');
    const helper = region.querySelector('[data-spotify-fallback-helper]');
    const link = region.querySelector('#spotify-fallback-link');
    if (helper instanceof HTMLElement) {
      helper.hidden = true;
      helper.textContent = '';
    }
    if (link instanceof HTMLElement) {
      link.removeAttribute('aria-describedby');
    }
  }

  function revealFallbackRecovery(root) {
    const region = getFallbackRegion(root);
    if (!region) return null;
    region.hidden = false;
    region.dataset.recovery = 'true';
    const helper = region.querySelector('[data-spotify-fallback-helper]');
    const link = region.querySelector('#spotify-fallback-link');
    if (helper instanceof HTMLElement) {
      helper.hidden = false;
      helper.textContent = FALLBACK_HELPER_TIMEOUT;
    }
    if (link instanceof HTMLElement) {
      link.setAttribute('aria-describedby', 'spotify-fallback-helper');
      return link;
    }
    return null;
  }

  function clearReadyConfirm(root) {
    const section = getSection(root);
    const ready = section?.querySelector('[data-spotify-ready]');
    if (!(ready instanceof HTMLElement)) return;
    window.clearTimeout(Number(ready.dataset.confirmTimer || 0));
    ready.hidden = true;
    ready.textContent = '';
    ready.removeAttribute('data-confirm-timer');
    ready.classList.remove('spotify-embed__ready--in', 'spotify-embed__ready--out');
  }

  /** Peak–end: after “Listo” exits, seal the player with a lasting quiet cue. */
  function sealLivePlayer(root) {
    if (!(root instanceof HTMLElement)) return;
    root.dataset.live = 'true';
    if (!prefersMotion()) return;
    root.classList.remove('spotify-embed__player--seal');
    void root.offsetWidth;
    root.classList.add('spotify-embed__player--seal');
    const clearSealMotion = () => {
      root.classList.remove('spotify-embed__player--seal');
    };
    root.addEventListener('animationend', clearSealMotion, { once: true });
    window.setTimeout(clearSealMotion, 900);
  }

  function showReadyConfirm(root) {
    const section = getSection(root);
    const ready = section?.querySelector('[data-spotify-ready]');
    if (!(ready instanceof HTMLElement)) return;
    window.clearTimeout(Number(ready.dataset.confirmTimer || 0));
    ready.hidden = false;
    ready.textContent = EMBED_READY_CONFIRM;
    ready.classList.remove('spotify-embed__ready--out');
    void ready.offsetWidth;
    ready.classList.add('spotify-embed__ready--in');
    const timerId = window.setTimeout(() => {
      ready.classList.remove('spotify-embed__ready--in');
      ready.classList.add('spotify-embed__ready--out');
      let sealed = false;
      const finishPeakEnd = () => {
        if (sealed) return;
        sealed = true;
        ready.hidden = true;
        ready.textContent = '';
        ready.classList.remove('spotify-embed__ready--out');
        sealLivePlayer(root);
      };
      if (prefersMotion()) {
        ready.addEventListener('transitionend', finishPeakEnd, { once: true });
        window.setTimeout(finishPeakEnd, 360);
      } else {
        finishPeakEnd();
      }
    }, EMBED_READY_CONFIRM_MS);
    ready.dataset.confirmTimer = String(timerId);
  }

  function settlePlayerSlot(root, iframe) {
    if (!(root instanceof HTMLElement) || !(iframe instanceof HTMLElement)) {
      return;
    }
    root.style.setProperty('--spotify-embed-h', `${playerHeight}px`);
    iframe.height = String(playerHeight);
  }

  function revealPlayer(iframe, facade) {
    if (!(iframe instanceof HTMLElement)) return;

    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      facade?.remove();
      iframe.classList.remove('spotify-embed__frame--enter');
    };

    if (!(facade instanceof HTMLElement) || !prefersMotion()) {
      facade?.remove();
      iframe.classList.remove('spotify-embed__frame--pending');
      return;
    }

    facade.classList.add('spotify-embed__facade--exit');
    iframe.classList.remove('spotify-embed__frame--pending');
    iframe.classList.add('spotify-embed__frame--enter');
    facade.addEventListener('transitionend', finish, { once: true });
    window.setTimeout(finish, 480);
  }

  function finishEmbedMount(root, iframe, facade, status, timedOut) {
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.loaded === 'true') return;

    delete root.dataset.loading;

    // Compact chrome first, then flip layout mode — avoids a tall empty flash.
    settlePlayerSlot(root, iframe);
    root.dataset.loaded = 'true';

    if (timedOut) {
      facade?.remove();
      iframe.classList.remove('spotify-embed__frame--pending');
      clearReadyConfirm(root);
    } else {
      revealPlayer(iframe, facade);
      showReadyConfirm(root);
    }

    if (status instanceof HTMLElement) {
      status.setAttribute('aria-live', timedOut ? 'assertive' : 'polite');
      status.textContent = timedOut
        ? EMBED_TIMEOUT_STATUS
        : EMBED_LOADED_STATUS;
    }

    if (timedOut) {
      const fallbackLink = revealFallbackRecovery(root);
      if (fallbackLink instanceof HTMLElement) {
        fallbackLink.focus({ preventScroll: true });
        return;
      }
    } else {
      hideFallbackRecovery(root);
    }

    try {
      iframe.focus({ preventScroll: true });
    } catch {
      root.setAttribute('tabindex', '-1');
      root.focus({ preventScroll: true });
    }
  }

  function mountSpotifyEmbed(root) {
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.loaded === 'true' || root.dataset.loading === 'true') {
      return;
    }
    root.dataset.loading = 'true';
    clearReadyConfirm(root);

    const facade = root.querySelector('[data-spotify-facade]');
    const status = root.querySelector('[data-spotify-status]');
    const control = root.querySelector('[data-spotify-load]');
    const label = root.querySelector('[data-spotify-load-label]');

    if (control instanceof HTMLElement) {
      control.setAttribute('aria-busy', 'true');
      control.setAttribute('aria-disabled', 'true');
      control.setAttribute('tabindex', '-1');
    }
    if (label instanceof HTMLElement) {
      label.textContent = LOADING_EMBED_LABEL;
    }
    if (status instanceof HTMLElement) {
      status.setAttribute('aria-live', 'polite');
      status.textContent = LOADING_EMBED_LABEL;
    }

    const iframe = document.createElement('iframe');
    iframe.className = 'spotify-embed__frame spotify-embed__frame--pending';
    iframe.src = embedSrc;
    iframe.width = '100%';
    // Compact height from the start; facade covers the taller idle slot.
    iframe.height = String(playerHeight);
    iframe.setAttribute(
      'allow',
      'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture',
    );
    iframe.allowFullscreen = true;
    iframe.loading = 'eager';
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.title = iframeTitle;
    iframe.tabIndex = -1;

    let settled = false;
    const settle = (timedOut) => {
      if (settled) return;
      settled = true;
      window.clearTimeout(timeoutId);
      finishEmbedMount(root, iframe, facade, status, timedOut);
    };

    const timeoutId = window.setTimeout(() => settle(true), EMBED_LOAD_TIMEOUT_MS);
    iframe.addEventListener('load', () => settle(false), { once: true });

    root.prepend(iframe);
  }

  function enhanceSpotifyPlayer(root) {
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    root.dataset.enhanced = 'true';

    // With JS, activation mounts in-page — drop the new-tab announcement.
    const newTabHint = root.querySelector('[data-spotify-newtab]');
    newTabHint?.remove();

    // Progressive disclosure: recovery chrome only after timeout.
    hideFallbackRecovery(root);

    root.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const control = target.closest('[data-spotify-load]');
      if (!(control instanceof HTMLElement) || !root.contains(control)) {
        return;
      }
      if (root.dataset.loading === 'true' || root.dataset.loaded === 'true') {
        event.preventDefault();
        return;
      }
      event.preventDefault();
      mountSpotifyEmbed(root);
    });
  }

  document.querySelectorAll('[data-spotify-player]').forEach(enhanceSpotifyPlayer);
</script>

<style>
  .spotify-embed {
    scroll-margin-top: calc(var(--header-h) + var(--space-md));
    padding-block: var(--space-xl) calc(var(--space-xl) * 1.5);
    padding-inline: max(var(--space-md), env(safe-area-inset-left, 0px))
      max(var(--space-md), env(safe-area-inset-right, 0px));
    border-block-start: 1px solid var(--border);
  }

  .spotify-embed__inner {
    max-width: 52rem;
    margin-inline: auto;
  }

  .spotify-embed__stage {
    position: relative;
    /* One label line for “Listo…” — keeps the beat off También en */
    padding-block-end: calc(var(--text-label) * var(--leading-meta) + var(--space-sm));
  }

  .spotify-embed__heading {
    margin: 0 0 var(--space-md);
    padding-block-end: var(--space-sm);
    border-block-end: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 5.5vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  /*
   * Idle: 1:1 plane matching cover art — no landscape crop of EL/BRI/EFF.
   * Loaded: full-width compact Spotify chrome (see [data-loaded]).
   */
  .spotify-embed__player {
    position: relative;
    width: min(100%, var(--spotify-embed-h, 352px));
    aspect-ratio: 1;
    height: auto;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--primary);
    contain: layout paint;
  }

  .spotify-embed__player[data-loaded='true'] {
    width: 100%;
    aspect-ratio: auto;
    height: var(--spotify-embed-h, 152px);
    margin-inline: 0;
  }

  /* Lasting quiet cue after success — tertiary in the frame, not confetti */
  .spotify-embed__player[data-live='true'] {
    border-color: color-mix(in srgb, var(--tertiary) 42%, var(--border));
  }

  @media (prefers-reduced-motion: no-preference) {
    .spotify-embed__player--seal {
      animation: spotify-embed-seal 0.72s var(--ease-settle) both;
    }
  }

  @keyframes spotify-embed-seal {
    0% {
      box-shadow: 0 0 0 0 transparent;
    }
    40% {
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--tertiary) 50%, transparent);
    }
    100% {
      box-shadow: none;
    }
  }

  .spotify-embed__player:focus {
    outline: none;
  }

  .spotify-embed__player:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /*
   * Cover-dominant facade: one plane. Brand art fills the slot;
   * the CTA overlays it. No empty elevated rail competing with the cover.
   */
  .spotify-embed__facade {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    display: grid;
    place-items: stretch stretch;
  }

  .spotify-embed__facade picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
  }

  .spotify-embed__facade-cover {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }

  /*
   * CTA bottom-end over jacket — left half stays clear for EL/BRI/EFF
   * (cover-art.md: wordmark owns the left stack; do not crop or cover it).
   */
  .spotify-embed__facade-action {
    position: relative;
    z-index: var(--z-raised);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: var(--space-md);
    background: transparent;
  }

  /*
   * Color strategy: tertiary owns the action; primary tint is a local plate
   * under the CTA only — never a full-cover wash that dulls the brand mark.
   */
  .spotify-embed__facade-scrim {
    display: block;
    position: absolute;
    left: auto;
    right: 0;
    top: auto;
    bottom: var(--space-sm);
    width: min(calc(var(--space-xl) * 6), 52%);
    height: calc(var(--space-xl) + var(--space-lg) + var(--space-md));
    translate: 0 0;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--primary) 80%, transparent) 0%,
      color-mix(in srgb, var(--primary) 30%, transparent) 58%,
      transparent 100%
    );
    pointer-events: none;
  }

  .spotify-embed__facade-btn {
    position: relative;
    z-index: var(--z-raised);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 2.75rem;
    min-width: 2.75rem;
    max-width: min(100%, 18rem);
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--tertiary);
    border-radius: var(--radius-sm);
    background: var(--tertiary);
    color: var(--ink-on-light);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-meta);
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    overflow-wrap: break-word;
    /* Single soft lift — avoid hairline + wide shadow pairing */
    box-shadow: 0 6px 16px color-mix(in srgb, var(--primary) 55%, transparent);
    transition:
      background-color 0.2s var(--ease-fade),
      color 0.2s var(--ease-fade),
      border-color 0.2s var(--ease-fade),
      box-shadow 0.2s var(--ease-fade),
      opacity 0.2s var(--ease-fade),
      transform 0.18s var(--ease-settle);
  }

  .spotify-embed__facade-btn[aria-busy='true'] {
    opacity: 0.72;
    cursor: wait;
    pointer-events: none;
    box-shadow: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .spotify-embed__facade-btn[aria-busy='true'] {
      animation: spotify-embed-wait 1.1s var(--ease-fade) infinite;
    }
  }

  @keyframes spotify-embed-wait {
    0%,
    100% {
      opacity: 0.88;
    }
    50% {
      opacity: 0.62;
    }
  }

  /* Cover yields to the player — editorial certainty, not spectacle */
  .spotify-embed__facade--exit {
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 0.36s var(--ease-fade),
      transform 0.42s var(--ease-settle);
    pointer-events: none;
  }

  .spotify-embed__frame--enter {
    animation: spotify-embed-frame-in 0.42s var(--ease-settle) both;
  }

  @keyframes spotify-embed-frame-in {
    from {
      opacity: 0;
      transform: translateY(var(--space-xs));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .spotify-embed__ready {
    position: absolute;
    left: 0;
    right: 0;
    top: auto;
    bottom: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: var(--weight-label);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-meta);
    text-transform: uppercase;
    color: var(--tertiary);
    opacity: 0;
    transform: translateY(var(--space-xs));
    pointer-events: none;
  }

  .spotify-embed__ready[hidden] {
    display: none;
  }

  .spotify-embed__ready--in {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.32s var(--ease-fade),
      transform 0.4s var(--ease-settle);
  }

  .spotify-embed__ready--out {
    opacity: 0;
    transform: translateY(calc(var(--space-xs) * -1));
    transition:
      opacity 0.3s var(--ease-fade),
      transform 0.3s var(--ease-fade);
  }

  @media (prefers-reduced-motion: reduce) {
    .spotify-embed__facade-btn {
      transition: none;
      animation: none;
      transform: none;
    }

    .spotify-embed__facade--exit,
    .spotify-embed__frame--enter,
    .spotify-embed__ready--in,
    .spotify-embed__ready--out,
    .spotify-embed__player--seal {
      animation: none;
      transition: none;
      transform: none;
    }

    .spotify-embed__ready--in {
      opacity: 1;
    }

    .spotify-embed__ready--out {
      opacity: 0;
    }
  }

  @media (pointer: coarse) {
    .spotify-embed__facade-btn {
      min-height: 3rem;
    }

    .spotify-embed__facade-scrim {
      width: min(calc(var(--space-xl) * 6.5), 58%);
      height: calc(var(--space-xl) * 2 + var(--space-sm));
    }
  }

  @media (hover: hover) {
    .spotify-embed__facade-btn:hover {
      background: color-mix(in srgb, var(--tertiary) 86%, var(--ink));
      color: var(--ink-on-light);
      border-color: color-mix(in srgb, var(--tertiary) 70%, var(--ink));
      text-decoration: none;
      transform: translateY(-1px);
      box-shadow: 0 8px 18px color-mix(in srgb, var(--primary) 60%, transparent);
    }

    .spotify-embed__facade-btn[aria-busy='true']:hover {
      background: var(--tertiary);
      color: var(--ink-on-light);
      border-color: var(--tertiary);
      box-shadow: none;
      transform: none;
    }
  }

  .spotify-embed__facade-btn:active {
    background: var(--surface-elevated);
    color: var(--ink);
    border-color: var(--tertiary);
    transform: translateY(1px);
    box-shadow: none;
  }

  .spotify-embed__facade-btn[aria-busy='true']:active {
    transform: none;
  }

  .spotify-embed__facade-btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .spotify-embed__frame {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
