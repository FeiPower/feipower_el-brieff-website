---
import { site } from '../config/site';
import type { CtaLocation } from '../lib/analytics/gtag.ts';

type Props = {
  heading?: string;
  ctaLocation?: CtaLocation;
};

const { heading = 'También en', ctaLocation = 'platform_links' } = Astro.props;
---

{
  site.platforms.length > 0 && (
    <section class="platform-links" aria-labelledby="platform-links-heading">
      <div class="platform-links__inner">
        <h2 class="platform-links__heading" id="platform-links-heading">
          {heading}
        </h2>
        <ul class="platform-links__list">
          {
            site.platforms.map((platform, index) => (
              <li class="platform-links__item">
                {index > 0 && (
                  <span class="platform-links__sep" aria-hidden="true">
                    /
                  </span>
                )}
                <a
                  class="platform-links__link"
                  href={platform.url}
                  rel="noopener noreferrer"
                  data-analytics-event="platform_outbound"
                  data-analytics-platform-id={platform.id}
                  data-analytics-cta-location={ctaLocation}
                >
                  {platform.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  )
}

<style>
  .platform-links {
    padding: var(--space-lg) var(--space-md) var(--space-xl);
    border-top: 1px solid var(--border);
    background: var(--primary);
  }

  .platform-links__inner {
    max-width: 40rem;
    margin: 0 auto;
  }

  .platform-links__heading {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .platform-links__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm) 0;
  }

  .platform-links__item {
    display: inline-flex;
    align-items: baseline;
  }

  .platform-links__sep {
    margin: 0 var(--space-sm);
    color: var(--border);
    font-size: 0.875rem;
    user-select: none;
  }

  .platform-links__link {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .platform-links__link:hover {
    border-bottom-color: var(--ink);
    text-decoration: none;
  }
</style>
