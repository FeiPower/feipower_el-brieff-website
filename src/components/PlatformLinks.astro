---
import { site } from '../config/site';
import type { CtaLocation, PlatformId } from '../lib/analytics/gtag.ts';

type Props = {
  heading?: string;
  ctaLocation?: CtaLocation;
  /** Omit platforms already owned by an adjacent primary surface (e.g. Spotify embed). */
  exclude?: PlatformId[];
};

const {
  heading = 'También en',
  ctaLocation = 'platform_links',
  exclude = [],
} = Astro.props;

const excludeSet = new Set(exclude);
const platforms = site.platforms.filter((platform) => !excludeSet.has(platform.id));
---

{
  platforms.length > 0 && (
    <section class="platform-links" aria-labelledby="platform-links-heading">
      <div class="platform-links__inner">
        <h2 class="platform-links__heading" id="platform-links-heading">
          {heading}
        </h2>
        <ul class="platform-links__list">
          {
            platforms.map((platform, index) => (
              <li class="platform-links__item">
                {index > 0 && (
                  <span class="platform-links__sep" aria-hidden="true">
                    /
                  </span>
                )}
                <a
                  class="platform-links__link"
                  href={platform.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-analytics-event="platform_outbound"
                  data-analytics-platform-id={platform.id}
                  data-analytics-cta-location={ctaLocation}
                >
                  {platform.label}
                  <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  )
}

<style>
  .platform-links {
    padding: var(--space-lg) var(--space-md) var(--space-xl);
    border-top: 1px solid var(--border);
    background: var(--primary);
  }

  .platform-links__inner {
    max-width: 52rem;
    margin: 0 auto;
  }

  .platform-links__heading {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .platform-links__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) 0;
  }

  .platform-links__item {
    display: inline-flex;
    align-items: center;
  }

  .platform-links__sep {
    margin: 0 var(--space-xs);
    color: var(--border);
    font-size: 0.875rem;
    user-select: none;
    pointer-events: none;
  }

  .platform-links__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding-inline: 0.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    box-shadow: inset 0 -1px 0 var(--border);
  }

  .platform-links__link:hover {
    box-shadow: inset 0 -1px 0 var(--ink);
    text-decoration: none;
  }

  .platform-links__link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
