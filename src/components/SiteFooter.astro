---
import { site } from '../config/site';
import BrieffyMark from './BrieffyMark.astro';

const producerName = site.producer.name.trim();
---

{
  producerName ? (
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="site-footer__credit">
          Producción por{' '}
          <BrieffyMark class="site-footer__producer" />
        </p>
      </div>
    </footer>
  ) : null
}

<style>
  .site-footer {
    border-block-start: 1px solid var(--border);
    padding-top: var(--space-xl);
    padding-bottom: max(var(--space-xl), env(safe-area-inset-bottom, 0px));
    padding-left: max(var(--space-md), env(safe-area-inset-left, 0px));
    padding-right: max(var(--space-md), env(safe-area-inset-right, 0px));
  }

  .site-footer__inner {
    max-width: 72rem;
    margin-inline: auto;
    text-align: center;
  }

  .site-footer__credit {
    margin-block: 0;
    margin-inline: auto;
    max-width: 40rem;
    font-family: var(--font-body);
    font-size: var(--text-meta);
    font-weight: var(--weight-body);
    line-height: var(--leading-meta);
    letter-spacing: var(--tracking-meta);
    color: var(--muted);
    overflow-wrap: break-word;
  }

  .site-footer__credit :global(.site-footer__producer) {
    --producer-mark-h: 1.35rem;
    margin-inline-start: 0.2em;
    vertical-align: -0.28em;
  }
</style>
