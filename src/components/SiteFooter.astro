---
import { site } from '../config/site';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__credit">
      Producción por
      <span class="site-footer__producer">{site.producer.name}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: var(--space-xl) var(--space-md);
  }

  .site-footer__inner {
    max-width: 72rem;
    margin: 0 auto;
    text-align: center;
  }

  .site-footer__credit {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .site-footer__producer {
    font-family: var(--font-script);
    font-size: 1.25rem;
    color: var(--ink);
  }
</style>
