---
import { site } from '../config/site';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label={`${site.name} — inicio`}>
      {site.name}
    </a>
    <nav class="site-header__nav" aria-label="Principal">
      <a class="site-header__link" href="/">Inicio</a>
      <a
        class="site-header__link"
        href="/#escuchar"
        data-analytics-event="listen_cta"
        data-analytics-cta-id="nav_escuchar"
        data-analytics-cta-location="nav"
      >
        Escuchar
      </a>
      <a class="site-header__link" href="/about">Acerca</a>
      <a class="site-header__link" href="/media-kit">Prensa</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    background: transparent;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-md) var(--space-md);
  }

  @media (min-width: 768px) {
    .site-header__inner {
      padding: var(--space-lg) var(--space-xl);
    }
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    opacity: 0.85;
  }

  .site-header__brand:hover {
    opacity: 1;
    text-decoration: none;
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-lg);
  }

  .site-header__link {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .site-header__link:hover,
  .site-header__link[aria-current='page'] {
    color: var(--ink);
    text-decoration: none;
  }
</style>
