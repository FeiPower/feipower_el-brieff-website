---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import { site } from '../config/site';

const title = `Media kit — ${site.name} | Prensa`;
const description =
  'Solicita el media kit PDF de El Brieff: pitch, bio del conductor, plataformas y contacto de prensa.';
const emailEnabled = site.features.mediaKitEmailEnabled;
---

<BaseLayout title={title} description={description} canonicalPath="/media-kit">
  <SiteHeader />
  <main id="contenido">
    <section class="media-kit" aria-labelledby="media-kit-heading">
      <div class="media-kit__inner">
        <p class="media-kit__brand">{site.name}</p>
        <h1 class="media-kit__heading" id="media-kit-heading">Media kit</h1>
        <p class="media-kit__lede">
          PDF con pitch, bio del conductor, hechos del programa, plataformas y
          contacto de prensa.
        </p>

        {
          !emailEnabled && (
            <p class="media-kit__notice" role="status">
              Las solicitudes por formulario aún no están posibles. Para recibir
              el PDF, escribe a{' '}
              <a href={`mailto:${site.press.to}`}>{site.press.to}</a>.
            </p>
          )
        }

        <form
          class="media-kit__form"
          id="media-kit-form"
          novalidate
          aria-describedby={!emailEnabled ? 'media-kit-disabled-hint' : undefined}
        >
          {
            !emailEnabled && (
              <p id="media-kit-disabled-hint" class="visually-hidden">
                Formulario deshabilitado hasta que el servicio de correo esté
                listo.
              </p>
            )
          }

          <div class="media-kit__field">
            <label for="mk-name">Nombre</label>
            <input
              id="mk-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              minlength="2"
              maxlength="120"
              aria-describedby="mk-name-error"
              disabled={!emailEnabled}
            />
            <p class="media-kit__field-error" id="mk-name-error" hidden></p>
          </div>

          <div class="media-kit__field">
            <label for="mk-email">Correo</label>
            <input
              id="mk-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              maxlength="200"
              aria-describedby="mk-email-error"
              disabled={!emailEnabled}
            />
            <p class="media-kit__field-error" id="mk-email-error" hidden></p>
          </div>

          <div class="media-kit__field">
            <label for="mk-org">Organización (opcional)</label>
            <input
              id="mk-org"
              name="organization"
              type="text"
              autocomplete="organization"
              maxlength="200"
              disabled={!emailEnabled}
            />
          </div>

          <div class="media-kit__field">
            <label for="mk-reason">Motivo (opcional)</label>
            <select id="mk-reason" name="reason" disabled={!emailEnabled}>
              <option value="">Selecciona un motivo…</option>
              <option value="prensa">Prensa</option>
              <option value="partnership">Alianza</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          {
            emailEnabled && (
              <div class="visually-hidden" aria-hidden="true" inert>
                <label for="mk-website">Website</label>
                <input
                  id="mk-website"
                  name="website"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </div>
            )
          }

          <p
            class="media-kit__status"
            id="media-kit-status"
            role="status"
            aria-live="polite"
            hidden></p>

          <button
            class="media-kit__submit"
            type="submit"
            disabled={!emailEnabled}
          >
            Solicitar media kit
          </button>
        </form>
      </div>
    </section>

    <PlatformLinks heading="Plataformas" ctaLocation="media_kit" />
  </main>
  <SiteFooter />
</BaseLayout>

<script define:vars={{ emailEnabled }}>
  import {
    trackMediaKitDownload,
    trackMediaKitFormStart,
    trackMediaKitSubmit,
    trackMediaKitSubmitError,
  } from '../lib/analytics/media-kit.ts';

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const REQUEST_TIMEOUT_MS = 15000;
  const SUBMIT_LABEL = 'Solicitar media kit';

  const form = document.getElementById('media-kit-form');
  const statusEl = document.getElementById('media-kit-status');
  const nameField = document.getElementById('mk-name');
  const emailField = document.getElementById('mk-email');
  const submitButton =
    form instanceof HTMLFormElement
      ? form.querySelector('button[type="submit"]')
      : null;

  let formStartTracked = false;
  let submitting = false;

  function showStatus(message, isError = false) {
    if (!(statusEl instanceof HTMLElement)) return;
    statusEl.hidden = false;
    statusEl.textContent = message;
    statusEl.dataset.state = isError ? 'error' : 'ok';
    // Errors interrupt; success/progress stay polite.
    statusEl.setAttribute('aria-live', isError ? 'assertive' : 'polite');
  }

  function setFieldError(field, message) {
    if (!(field instanceof HTMLElement)) return;
    const errorEl = document.getElementById(`${field.id}-error`);
    const hasError = Boolean(message);
    field.setAttribute('aria-invalid', hasError ? 'true' : 'false');
    if (errorEl instanceof HTMLElement) {
      errorEl.textContent = message ?? '';
      errorEl.hidden = !hasError;
    }
  }

  function validate(payload) {
    const invalid = [];
    if (payload.name.length < 2) {
      invalid.push([nameField, 'Escribe tu nombre (al menos 2 caracteres).']);
    }
    if (!EMAIL_RE.test(payload.email)) {
      invalid.push([
        emailField,
        'Escribe un correo válido. Ejemplo: nombre@medio.com',
      ]);
    }
    setFieldError(nameField, null);
    setFieldError(emailField, null);
    for (const [field, message] of invalid) {
      setFieldError(field, message);
    }
    return invalid;
  }

  function setSubmitting(isSubmitting) {
    submitting = isSubmitting;
    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = isSubmitting;
      submitButton.textContent = isSubmitting ? 'Enviando…' : SUBMIT_LABEL;
    }
  }

  if (emailEnabled && form instanceof HTMLFormElement) {
    form.addEventListener(
      'focusin',
      () => {
        if (formStartTracked) return;
        formStartTracked = true;
        trackMediaKitFormStart();
      },
      { once: true },
    );

    // Clear a field's error as soon as the user starts correcting it.
    for (const field of [nameField, emailField]) {
      field?.addEventListener('input', () => setFieldError(field, null));
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!emailEnabled || !(form instanceof HTMLFormElement)) {
      showStatus('El formulario no está disponible por ahora.', true);
      return;
    }
    // Guard against rapid re-submission spawning duplicate requests.
    if (submitting) return;

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      organization: String(data.get('organization') ?? '').trim() || undefined,
      reason: String(data.get('reason') ?? '').trim() || undefined,
      website: String(data.get('website') ?? ''),
    };

    const invalid = validate(payload);
    if (invalid.length > 0) {
      const [firstField] = invalid[0];
      if (firstField instanceof HTMLElement) firstField.focus();
      trackMediaKitSubmitError('validation');
      showStatus('Revisa los campos marcados e inténtalo de nuevo.', true);
      return;
    }

    setSubmitting(true);
    showStatus('Enviando…');

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);

    try {
      const response = await fetch('/api/media-kit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });

      let result = null;
      try {
        result = await response.json();
      } catch {
        result = null;
      }

      if (!result || !result.ok || !result.downloadUrl) {
        const messages = {
          validation: 'Revisa nombre y correo e inténtalo de nuevo.',
          honeypot: 'No se pudo completar la solicitud.',
          rate_limit:
            'Demasiadas solicitudes desde este dispositivo. Espera unos minutos e inténtalo de nuevo.',
          email_failed:
            'No pudimos enviar el aviso por correo. Intenta más tarde o escribe a prensa.',
          disabled: 'Las solicitudes por formulario no están posibles por ahora.',
        };
        const errorCode = result && result.error ? result.error : 'network';
        trackMediaKitSubmitError(errorCode);
        showStatus(
          messages[errorCode] ??
            'No se pudo completar la solicitud. Intenta de nuevo.',
          true,
        );
        setSubmitting(false);
        return;
      }

      trackMediaKitSubmit(payload.reason);
      trackMediaKitDownload();
      // Leave the button disabled; navigation is imminent.
      showStatus('Listo. Descargando el media kit…');
      window.location.assign(result.downloadUrl);
    } catch (error) {
      const timedOut = error && error.name === 'AbortError';
      trackMediaKitSubmitError('network');
      showStatus(
        timedOut
          ? 'La solicitud tardó demasiado. Revisa tu conexión e inténtalo de nuevo.'
          : 'No pudimos conectar. Revisa tu conexión e inténtalo de nuevo.',
        true,
      );
      setSubmitting(false);
    } finally {
      clearTimeout(timeout);
    }
  });
</script>

<style>
  .media-kit {
    padding: calc(var(--header-h) + var(--space-lg)) var(--space-md)
      var(--space-xl);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(
        ellipse 70% 45% at 80% 10%,
        var(--surface-elevated) 0%,
        transparent 55%
      ),
      var(--primary);
  }

  @media (min-width: 768px) {
    .media-kit {
      padding: calc(var(--header-h) + var(--space-md)) var(--space-xl)
        var(--space-xl);
    }
  }

  .media-kit__inner {
    max-width: 32rem;
    margin: 0 auto;
  }

  .media-kit__brand {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .media-kit__heading {
    margin: 0 0 var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--ink);
  }

  .media-kit__lede {
    margin: 0 0 var(--space-lg);
    color: var(--muted);
  }

  .media-kit__notice {
    margin: 0 0 var(--space-lg);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    color: var(--ink);
  }

  .media-kit__notice a {
    color: var(--ink);
  }

  .media-kit__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .media-kit__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .media-kit__field label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .media-kit__field input,
  .media-kit__field select {
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-elevated);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .media-kit__field input:disabled,
  .media-kit__field select:disabled,
  .media-kit__submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .media-kit__field input[aria-invalid='true'] {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .media-kit__field-error {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--accent);
  }

  .media-kit__status {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .media-kit__status[data-state='error'] {
    color: var(--ink);
  }

  .media-kit__submit {
    align-self: flex-start;
    min-height: 2.75rem;
    padding: var(--space-sm) var(--space-lg);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
    border: 1px solid var(--tertiary);
    background: var(--tertiary);
    color: var(--ink-on-light);
    cursor: pointer;
  }

  .media-kit__submit:hover:not(:disabled) {
    background: transparent;
    color: var(--ink);
  }

  .media-kit__submit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
