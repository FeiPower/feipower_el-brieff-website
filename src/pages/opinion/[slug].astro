---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import JsonLd from '../../components/JsonLd.astro';
import { site } from '../../config/site';
import { NotFoundError } from '../../lib/editorial/repository.ts';
import { getEditorialRepository } from '../../lib/editorial/runtime.ts';
import {
  articleCanonicalPath,
  buildArticleJsonLd,
  isValidArticleForSeo,
  markdownToSafeParagraphHtml,
} from '../../lib/editorial/seo.ts';

const slug = Astro.params.slug;
if (!slug) {
  return Astro.redirect('/opinion/');
}

const repository = getEditorialRepository();
if (!repository) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

let content;
try {
  content = await repository.getContentItemBySlug(slug);
} catch (error) {
  if (error instanceof NotFoundError) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  throw error;
}

if (!isValidArticleForSeo(content)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const citations = await repository.listCitations(content.id);
const canonicalPath = articleCanonicalPath(content.slug);
const jsonLd = buildArticleJsonLd({
  content,
  authorName: site.host.name,
});
const bodyHtml = markdownToSafeParagraphHtml(content.bodyMarkdown);
const publishedLabel = content.publishedAt
  ? new Date(content.publishedAt).toLocaleDateString('es-MX', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<BaseLayout
  title={`${content.title} — El Brieff`}
  description={content.summary}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedTime={content.publishedAt}
  modifiedTime={content.updatedAt}
>
  <JsonLd slot="head" graph={jsonLd} />
  <SiteHeader />
  <main id="contenido" class="editorial-shell">
    <article>
      <header class="editorial-header">
        <p class="editorial-kicker">Opinión</p>
        <h1>{content.title}</h1>
        <p class="byline">
          Por <span>{site.host.name}</span>
          {
            content.publishedAt && (
              <>
                {' · '}
                <time datetime={content.publishedAt}>{publishedLabel}</time>
              </>
            )
          }
        </p>
        <p class="lede">{content.summary}</p>
      </header>

      <div class="article-body" set:html={bodyHtml} />

      {
        citations.length > 0 && (
          <section class="article-sources" aria-labelledby="fuentes">
            <h2 id="fuentes">Fuentes</h2>
            <ul class="article-sources__list">
              {citations.map((citation) => (
                <li class="article-sources__item">
                  <p class="article-sources__claim">{citation.claim}</p>
                  <p class="editorial-meta">{citation.excerpt}</p>
                  <a
                    class="article-sources__link"
                    href={citation.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {citation.sourceUrl}
                    <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .byline {
    margin: 0 0 var(--space-md);
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .lede {
    margin: 0;
    max-width: 65ch;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .article-body {
    display: grid;
    gap: var(--space-md);
    max-width: 65ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .article-body :global(p) {
    margin: 0;
  }

  .article-sources {
    margin-top: calc(var(--space-xl) + var(--space-md));
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border);
  }

  .article-sources h2 {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .article-sources__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .article-sources__item {
    display: grid;
    gap: var(--space-sm);
  }

  .article-sources__claim {
    margin: 0;
    color: var(--ink);
    line-height: 1.5;
  }

  .article-sources__link {
    color: var(--accent);
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>
