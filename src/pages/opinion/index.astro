---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { site } from '../../config/site';
import { getEditorialRepository } from '../../lib/editorial/runtime.ts';
import {
  articleCanonicalPath,
  isValidArticleForSeo,
} from '../../lib/editorial/seo.ts';

const repository = getEditorialRepository();
const published = repository
  ? (await repository.listPublishedByKind('column')).filter(isValidArticleForSeo)
  : [];

const title = 'Opinión — El Brieff';
const description =
  'Columnas de opinión de Arturo Salazar sobre actualidad empresarial y conversación pública.';
---

<BaseLayout title={title} description={description} canonicalPath="/opinion/">
  <SiteHeader />
  <main id="contenido" class="editorial-shell">
    <header class="editorial-header">
      <p class="editorial-kicker">Archivo editorial</p>
      <h1>Opinión</h1>
      <p class="editorial-meta">{site.host.name}</p>
    </header>

    {
      published.length === 0 ? (
        <p class="editorial-empty">
          Aún no hay columnas publicadas. Vuelve pronto o{' '}
          <a href="/#escuchar">escucha el podcast</a>.
        </p>
      ) : (
        <ul class="opinion-list">
          {published.map((item) => (
            <li class="opinion-list__item">
              <a class="opinion-list__title" href={articleCanonicalPath(item.slug)}>
                <h2>{item.title}</h2>
              </a>
              <p class="editorial-meta">
                <time datetime={item.publishedAt ?? undefined}>
                  {item.publishedAt
                    ? new Date(item.publishedAt).toLocaleDateString('es-MX', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })
                    : ''}
                </time>
              </p>
              <p class="opinion-list__summary">{item.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .opinion-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Generous separation between entries; tight cluster inside each item */
    gap: calc(var(--space-xl) + var(--space-md));
  }

  .opinion-list__item {
    display: grid;
    gap: var(--space-sm);
  }

  .opinion-list__title {
    text-decoration: none;
  }

  .opinion-list__title h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
    color: var(--ink);
  }

  .opinion-list__title:hover h2 {
    color: var(--accent);
  }

  .opinion-list__title:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .opinion-list__summary {
    margin: 0;
    max-width: 65ch;
    color: var(--ink);
    line-height: 1.55;
    text-wrap: pretty;
  }
</style>
