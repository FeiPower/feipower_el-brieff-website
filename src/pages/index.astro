---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import JsonLd from '../components/JsonLd.astro';

const title = 'El Brieff — Informarte en 15 minutos | México y el mundo';
const description =
  'El Brieff: podcast diario de ~15 minutos sobre los temas de conversación más importantes de México y el mundo, con Arturo Salazar.';
---

<BaseLayout title={title} description={description}>
  <JsonLd />
  <SiteHeader />
  <main id="contenido">
    <Hero />
    <SpotifyEmbed />
    <PlatformLinks />
    <p class="home-opinion-link">
      <a href="/opinion/">Leer columnas de opinión</a>
    </p>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .home-opinion-link {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
    text-align: center;
  }

  .home-opinion-link a {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
