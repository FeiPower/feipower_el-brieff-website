---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
import SpotifyEmbed from '../components/SpotifyEmbed.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import JsonLd from '../components/JsonLd.astro';
import { HERO_IMAGE } from '../lib/hero-image';

const title = 'El Brieff — Informarte en 15 minutos | México y el mundo';
const description =
  'El Brieff: podcast diario de ~15 minutos sobre los temas de conversación más importantes de México y el mundo, con Arturo Salazar.';
---

<BaseLayout title={title} description={description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={HERO_IMAGE.avifSrcSet}
    imagesizes={HERO_IMAGE.sizes}
    fetchpriority="high"
  />
  <JsonLd />
  <SiteHeader />
  <main id="contenido">
    <Hero />
    <SpotifyEmbed />
    <PlatformLinks />
    <p class="home-opinion-link">
      <a href="/opinion/">Leer columnas de opinión</a>
    </p>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .home-opinion-link {
    margin: 0 auto var(--space-xl);
    width: min(1120px, calc(100% - 2 * var(--space-lg)));
    text-align: center;
  }

  .home-opinion-link a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding-inline: var(--space-md);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .home-opinion-link a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .home-opinion-link a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
